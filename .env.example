# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Every variable the stack reads is listed here. Values below are for LOCAL
# DEVELOPMENT ONLY. Staging/production values live in the host's secret store.

# --- Runtime ---
# One of: dev, test, staging. Controls defaults such as bucket auto-creation.
APP_ENV=dev
# Port the API is published on, on your machine.
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_USER=resume
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=resume_engine
POSTGRES_PORT=5432
# DSN the API uses. Host "postgres" is the compose service name; the
# integration tests running on your machine override it with localhost.
DATABASE_URL=postgresql://resume:change-me-local-only@postgres:5432/resume_engine

# --- Redis (Celery broker + rate-limit counters from M4) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Object storage (SeaweedFS S3 gateway, see ADR-010) ---
S3_PORT=8333
S3_ENDPOINT_URL=http://storage:8333
S3_REGION=us-east-1
# Must match infra/seaweedfs/s3.dev.json (dev-only identity).
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_BUCKET=resumes
# Create the bucket at API startup if missing. true only in dev/test.
S3_AUTO_CREATE_BUCKET=true

# --- CORS ---
# Browser origins allowed to call the API: the Flutter web dev server.
# JSON list. Never "*".
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]

# --- Readiness probe ---
# Seconds each dependency check in /ready may take before it counts as failed.
READY_CHECK_TIMEOUT_SECONDS=2

# --- Label Studio (gold-set labeling; `make label`) ---
LABEL_STUDIO_PORT=8081
# Your local login. Pick your own password; .env is never committed.
LABEL_STUDIO_USERNAME=you@example.com
LABEL_STUDIO_PASSWORD=change-me-local-only
